# Apache SPA Fallback — CyBeat Frontend
#
# Required for Vue Router history mode on shared hosting.
# Serves index.html for all unknown routes so /login, /register, /
# work correctly when accessed directly or on page refresh.
#
# Existing files (JS/CSS/images) and directories are served normally —
# only unknown routes are rewritten to index.html.

Options -MultiViews
RewriteEngine On

# If the request is for an existing file, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
# If the request is for an existing directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-d
# Otherwise, rewrite to index.html
RewriteRule ^ index.html [QSA,L]
